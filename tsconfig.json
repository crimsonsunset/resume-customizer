{
  "extends": "$app/tsconfig",
  "compilerOptions": {
    // Essential fallback settings only - let SvelteKit handle paths
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "paths": {
      "@web/*": ["./src/web/*"],
      "@shared/*": ["./src/shared/*"]
    }
  }
}
